# Files and directories excluded from the production plugin zip.
# Used by build scripts that ship installable releases.

# Source control
.git
.gitignore
.gitattributes

# Development tooling
.github
.wp-env.json
.wp-env.override.json
.wp-env
.phpunit.cache
.phpunit.result.cache
.distignore
.editorconfig
.DS_Store

# Tests and dev scripts
tests
bin
scripts
tools

# Composer dev dependencies — all vendor/ packages are dev-only (phpcs,
# phpunit, etc.); there are no production PHP dependencies.
composer.json
composer.lock
vendor

# Node / npm build tooling
package.json
package-lock.json
node_modules

# Linting / standards configs
phpcs.xml.dist
phpunit.xml.dist

# Local-only dev plugins
vendor-plugins

# Documentation that lives in-repo for contributors but isn't needed
# at runtime
CONTRIBUTING.md
CODE_OF_CONDUCT.md
SECURITY.md
.migration
docs

# Agent workflow skills are part of the installable AI toolkit. They are
# static reference files and should ship in the plugin zip.

# Editor / OS metadata
*.log
*.swp
.idea
.vscode
