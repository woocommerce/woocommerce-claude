#!/usr/bin/env bash
#
# Reproduce the merchant upgrade path that must keep working:
#
#   1. Install the public v0.4.2 WordPress plugin zip.
#   2. Create the WooCommerce for Claude setup key once.
#   3. Confirm MCP initialize + tools/list works.
#   4. Replace only the plugin files with the current release zip.
#   5. Confirm the stored key is unchanged and tools/list still works.
#
# This intentionally uses a disposable wp-env project in /private/tmp and does
# not touch the user's Claude Desktop or Claude Code MCP configuration.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CURRENT_ZIP="${CURRENT_ZIP:-$REPO_ROOT/woocommerce-claude.zip}"
BASELINE_ZIP_URL="${BASELINE_ZIP_URL:-https://github.com/woocommerce/woocommerce-claude/releases/download/v0.4.2/woocommerce-claude.zip}"
WORK_DIR="${WORK_DIR:-/private/tmp/woocommerce-claude-upgrade-smoke}"
PORT="${PORT:-8898}"

cd "$REPO_ROOT"

fail() {
	printf '\nUpgrade compatibility check failed: %s\n' "$1" >&2
	exit 1
}

step() {
	printf '\n==> %s\n' "$1"
}

if [ ! -f "$CURRENT_ZIP" ]; then
	fail "Current release zip not found at $CURRENT_ZIP. Run pnpm run plugin-zip first."
fi

rm -rf "$WORK_DIR"
mkdir -p "$WORK_DIR/baseline" "$WORK_DIR/current" "$WORK_DIR/active-plugin" "$WORK_DIR/tools/mu-plugins"

step "Preparing baseline and current plugin zips"
curl -fsSL -o "$WORK_DIR/woocommerce-claude-0.4.2.zip" "$BASELINE_ZIP_URL"
unzip -q "$WORK_DIR/woocommerce-claude-0.4.2.zip" -d "$WORK_DIR/baseline"
unzip -q "$CURRENT_ZIP" -d "$WORK_DIR/current"
cp -R "$WORK_DIR/baseline/woocommerce-claude/." "$WORK_DIR/active-plugin/"
cp -R "$REPO_ROOT/tools/mu-plugins/." "$WORK_DIR/tools/mu-plugins/"

cat > "$WORK_DIR/.wp-env.json" <<JSON
{
  "core": "WordPress/WordPress#6.9",
  "port": $PORT,
  "testsEnvironment": false,
  "plugins": [
    "https://downloads.wordpress.org/plugin/woocommerce.zip",
    "https://downloads.wordpress.org/plugin/gutenberg.zip"
  ],
  "mappings": {
    "wp-content/plugins/woocommerce-claude": "$WORK_DIR/active-plugin",
    "wp-content/mu-plugins": "$WORK_DIR/tools/mu-plugins"
  },
  "config": {
    "WP_DEBUG": true,
    "WP_DEBUG_LOG": true,
    "SCRIPT_DEBUG": true
  }
}
JSON

cleanup() {
	pnpm exec wp-env --config "$WORK_DIR/.wp-env.json" stop >/dev/null 2>&1 || true
}
trap cleanup EXIT

step "Starting disposable wp-env on port $PORT"
pnpm exec wp-env --config "$WORK_DIR/.wp-env.json" start

wp_env() {
	pnpm exec wp-env --config "$WORK_DIR/.wp-env.json" run cli -- "$@"
}

step "Activating WooCommerce and WooCommerce for Claude v0.4.2"
wp_env wp plugin activate woocommerce woocommerce-claude
wp_env wp wc tool run install_pages --user=admin >/dev/null
wp_env wp option update woocommerce_store_address '123 Main Street' >/dev/null
wp_env wp option update woocommerce_store_city 'London' >/dev/null
wp_env wp option update woocommerce_store_postcode 'EC1A 1BB' >/dev/null
wp_env wp option update woocommerce_default_country 'GB' >/dev/null
wp_env wp option update woocommerce_currency 'GBP' >/dev/null

BASELINE_VERSION="$(wp_env wp plugin get woocommerce-claude --field=version | tail -n 1)"
[ "$BASELINE_VERSION" = "0.4.2" ] || fail "Expected baseline version 0.4.2, got $BASELINE_VERSION."

tools_list_smoke() {
	wp_env bash -s <<'CONTAINER_SCRIPT'
set -euo pipefail

MCP_URL="http://wordpress/wp-json/woocommerce-claude/mcp"
HEADERS_FILE="/tmp/woocommerce-claude-upgrade-headers.txt"
INIT_FILE="/tmp/woocommerce-claude-upgrade-init.json"
TOOLS_FILE="/tmp/woocommerce-claude-upgrade-tools.json"

CREDENTIAL="$(
	wp eval '
		$user = get_user_by( "login", "admin" );
		if ( ! $user ) {
			fwrite( STDERR, "Admin user not found.\n" );
			exit( 1 );
		}

		wp_set_current_user( $user->ID );
		$helper = new WooCommerce\Claude\Setup\RestApiKey();
		$state  = $helper->get_or_create();

		if ( is_wp_error( $state ) ) {
			fwrite( STDERR, $state->get_error_message() . "\n" );
			exit( 1 );
		}

		echo $state["credential"];
	' | tail -n 1
)"

curl -sS \
	-D "$HEADERS_FILE" \
	-o "$INIT_FILE" \
	-u "$CREDENTIAL" \
	-H "Content-Type: application/json" \
	-H "Accept: application/json, text/event-stream" \
	-d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"woocommerce-claude-upgrade-smoke","version":"0"}}}' \
	"$MCP_URL" >/dev/null

SESSION_ID="$(
	grep -i '^mcp-session-id:' "$HEADERS_FILE" \
		| tail -n 1 \
		| cut -d ' ' -f 2- \
		| tr -d '\r'
)"

if [ -z "$SESSION_ID" ]; then
	printf 'MCP initialize did not return an Mcp-Session-Id header.\n' >&2
	printf 'Initialize response:\n' >&2
	cat "$INIT_FILE" >&2
	exit 1
fi

curl -sS \
	-u "$CREDENTIAL" \
	-H "Content-Type: application/json" \
	-H "Accept: application/json, text/event-stream" \
	-H "Mcp-Session-Id: $SESSION_ID" \
	-d '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
	"$MCP_URL" >/dev/null

curl -sS \
	-o "$TOOLS_FILE" \
	-u "$CREDENTIAL" \
	-H "Content-Type: application/json" \
	-H "Accept: application/json, text/event-stream" \
	-H "Mcp-Session-Id: $SESSION_ID" \
	-d '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' \
	"$MCP_URL" >/dev/null

php -r '
	$payload = json_decode( file_get_contents( $argv[1] ), true );
	if ( ! is_array( $payload ) ) {
		fwrite( STDERR, "tools/list did not return JSON.\n" );
		exit( 1 );
	}
	if ( isset( $payload["error"] ) ) {
		fwrite( STDERR, "tools/list returned error: " . json_encode( $payload["error"] ) . "\n" );
		exit( 1 );
	}

	$expected = array(
		"woocommerce-claude-get-store-profile",
		"woocommerce-claude-get-readiness-score",
		"woocommerce-claude-get-recommendations",
		"woocommerce-claude-get-product-details",
		"woocommerce-claude-search-products",
		"woocommerce-claude-suggest-improvements",
		"wc-analytics-totals",
		"wc-analytics-breakdown",
		"wc-analytics-series",
		"wc-analytics-rows",
		"wc-analytics-confirm-large-range",
	);

	$names = array();
	foreach ( $payload["result"]["tools"] ?? array() as $tool ) {
		if ( isset( $tool["name"] ) ) {
			$names[] = $tool["name"];
		}
	}

	$missing = array_values( array_diff( $expected, $names ) );
	if ( $missing ) {
		fwrite( STDERR, "tools/list is missing expected tools: " . implode( ", ", $missing ) . "\n" );
		exit( 1 );
	}

	echo implode( "\n", $names ), "\n";
' "$TOOLS_FILE"
CONTAINER_SCRIPT
}

step "Checking v0.4.2 MCP tools/list"
tools_list_smoke

KEY_BEFORE="$(wp_env wp option get woocommerce_claude_setup_api_credential | tail -n 1)"
[ -n "$KEY_BEFORE" ] || fail "Baseline did not create a setup credential."

step "Replacing plugin files with current release zip"
find "$WORK_DIR/active-plugin" -mindepth 1 -maxdepth 1 -exec rm -rf {} +
cp -R "$WORK_DIR/current/woocommerce-claude/." "$WORK_DIR/active-plugin/"

UPGRADED_VERSION="$(wp_env wp plugin get woocommerce-claude --field=version | tail -n 1)"
[ "$UPGRADED_VERSION" != "0.4.2" ] || fail "Upgrade did not replace the plugin version."

KEY_AFTER="$(wp_env wp option get woocommerce_claude_setup_api_credential | tail -n 1)"
[ "$KEY_BEFORE" = "$KEY_AFTER" ] || fail "Stored setup credential changed during upgrade."

step "Checking upgraded MCP tools/list"
tools_list_smoke

step "Upgrade compatibility check passed: v0.4.2 -> $UPGRADED_VERSION kept the existing key and tools/list surface."
