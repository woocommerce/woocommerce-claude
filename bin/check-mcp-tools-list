#!/usr/bin/env bash
#
# Local MCP protocol smoke test for WooCommerce for Claude.
#
# This does not call a model. It creates/reuses the local setup key, performs
# a real MCP initialize request against wp-env's WordPress container, then
# calls tools/list and asserts the tool names the agent workflows depend on.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$REPO_ROOT"

pnpm exec wp-env run cli -- bash -s <<'CONTAINER_SCRIPT'
set -euo pipefail

MCP_URL="http://wordpress/wp-json/woocommerce-claude/mcp"
HEADERS_FILE="/tmp/woocommerce-claude-mcp-headers.txt"
INIT_FILE="/tmp/woocommerce-claude-mcp-init.json"
TOOLS_FILE="/tmp/woocommerce-claude-mcp-tools.json"

CREDENTIAL="$(
	wp eval '
		$user = get_user_by( "login", "admin" );
		if ( ! $user ) {
			fwrite( STDERR, "Admin user not found.\n" );
			exit( 1 );
		}

		wp_set_current_user( $user->ID );
		$helper = new WooCommerce\Claude\Setup\RestApiKey();
		$state  = $helper->get_or_create();

		if ( is_wp_error( $state ) ) {
			fwrite( STDERR, $state->get_error_message() . "\n" );
			exit( 1 );
		}

		echo $state["credential"];
	' | tail -n 1
)"

curl -sS \
	-D "$HEADERS_FILE" \
	-o "$INIT_FILE" \
	-u "$CREDENTIAL" \
	-H "Content-Type: application/json" \
	-H "Accept: application/json, text/event-stream" \
	-d '{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-03-26","capabilities":{},"clientInfo":{"name":"woocommerce-claude-smoke","version":"0"}}}' \
	"$MCP_URL" >/dev/null

SESSION_ID="$(
	grep -i '^mcp-session-id:' "$HEADERS_FILE" \
		| tail -n 1 \
		| cut -d ' ' -f 2- \
		| tr -d '\r'
)"

if [ -z "$SESSION_ID" ]; then
	printf 'MCP initialize did not return an Mcp-Session-Id header.\n' >&2
	printf 'Initialize response:\n' >&2
	cat "$INIT_FILE" >&2
	exit 1
fi

curl -sS \
	-u "$CREDENTIAL" \
	-H "Content-Type: application/json" \
	-H "Accept: application/json, text/event-stream" \
	-H "Mcp-Session-Id: $SESSION_ID" \
	-d '{"jsonrpc":"2.0","method":"notifications/initialized"}' \
	"$MCP_URL" >/dev/null

curl -sS \
	-o "$TOOLS_FILE" \
	-u "$CREDENTIAL" \
	-H "Content-Type: application/json" \
	-H "Accept: application/json, text/event-stream" \
	-H "Mcp-Session-Id: $SESSION_ID" \
	-d '{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}' \
	"$MCP_URL" >/dev/null

EXPECTED_TOOLS=(
	woocommerce-claude-get-store-profile
	woocommerce-claude-get-readiness-score
	woocommerce-claude-get-recommendations
	woocommerce-claude-get-product-details
	woocommerce-claude-search-products
	woocommerce-claude-suggest-improvements
	wc-analytics-totals
	wc-analytics-breakdown
	wc-analytics-series
	wc-analytics-rows
	wc-analytics-confirm-large-range
)

php -r '
	$payload = json_decode( file_get_contents( $argv[1] ), true );
	if ( ! is_array( $payload ) ) {
		fwrite( STDERR, "tools/list did not return JSON.\n" );
		exit( 1 );
	}
	if ( isset( $payload["error"] ) ) {
		fwrite( STDERR, "tools/list returned error: " . json_encode( $payload["error"] ) . "\n" );
		exit( 1 );
	}

	$tools = $payload["result"]["tools"] ?? array();
	$names = array();
	foreach ( $tools as $tool ) {
		if ( isset( $tool["name"] ) ) {
			$names[] = $tool["name"];
		}
	}

	$missing = array_values( array_diff( array_slice( $argv, 2 ), $names ) );
	if ( $missing ) {
		fwrite( STDERR, "tools/list is missing expected tools: " . implode( ", ", $missing ) . "\n" );
		exit( 1 );
	}

	foreach ( $names as $name ) {
		echo $name, PHP_EOL;
	}
' "$TOOLS_FILE" "${EXPECTED_TOOLS[@]}"
CONTAINER_SCRIPT
