{
  "name": "woocommerce-claude",
  "version": "0.4.3",
  "description": "Makes any WooCommerce store AI-operable",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "files": [
    "README.md",
    "LICENSE",
    "uninstall.php",
    "woocommerce-claude.php",
    "build",
    "includes",
    "skills",
    "vendor"
  ],
  "scripts": {
    "build": "mkdir -p build",
    "build:production": "mkdir -p build",
    "plugin-zip": "pnpm run build:production && wp-scripts plugin-zip",
