    "start": "pnpm run build"
  },
  "dependencies": {},
  "devDependencies": {
    "@babel/core": "7.29.0",
    "@wordpress/env": "11.5.0",
    "@wordpress/scripts": "32.1.0",
    "browserslist": "4.28.2"
  }
}
